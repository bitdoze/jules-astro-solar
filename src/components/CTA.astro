---
// src/components/CTA.astro
---
<section id="cta" class="py-20 md:py-28 px-4 bg-gradient-to-r from-green-500 to-green-700 text-white text-center">
  <div class="container mx-auto">
    <h2 class="text-4xl sm:text-5xl font-extrabold mb-6">Ready to Go Solar?</h2>
    <p class="text-lg sm:text-xl mb-10 max-w-2xl mx-auto">
      Let us help you find the perfect solar solution. Get in touch for a free, no-obligation consultation.
    </p>
    <a 
      href="/contact" 
      class="bg-yellow-400 text-gray-900 font-bold py-4 px-10 text-lg rounded-lg hover:bg-yellow-300 transform hover:scale-105 transition-all duration-300 ease-in-out shadow-lg hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-yellow-300 focus:ring-opacity-50"
    >
      Contact Us Today
    </a>
  </div>
</section>
