---
// src/components/ServicesPreview.astro
import SolarPanelIcon from '../assets/icons/solar-panel.svg?raw';
import CommercialIcon from '../assets/icons/commercial-building.svg?raw';
import BatteryIcon from '../assets/icons/battery.svg?raw';

const services = [
  { title: "Residential Solar", description: "Custom solar installations for your home.", link: "/services#residential", icon: SolarPanelIcon },
  { title: "Commercial Solutions", description: "Scalable solar systems for businesses.", link: "/services#commercial", icon: CommercialIcon },
  { title: "Battery Storage", description: "Store excess energy for use anytime.", link: "/services#storage", icon: BatteryIcon },
];
---
<section class="py-16 md:py-20 px-4 bg-gray-50">
  <div class="container mx-auto text-center">
    <h2 class="text-3xl sm:text-4xl font-bold mb-12 md:mb-16 text-gray-800">Our Core Services</h2>
    <div class="grid md:grid-cols-3 gap-8 lg:gap-10">
      {services.map(service => (
        <div class="bg-white p-6 md:p-8 rounded-xl shadow-lg border border-gray-200 hover:shadow-2xl hover:scale-105 transform transition-all duration-300 ease-in-out flex flex-col items-center">
          <div class="mb-5 h-14 w-14 text-green-500">
            <Fragment set:html={service.icon} />
          </div>
          <h3 class="text-xl lg:text-2xl font-semibold mb-3 text-gray-700">{service.title}</h3>
          <p class="text-gray-600 mb-5 text-center flex-grow text-sm sm:text-base">{service.description}</p>
          <a 
            href={service.link} 
            class="text-green-600 hover:text-green-700 font-semibold group transition-colors duration-300"
          >
            Learn More <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">&rarr;</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
