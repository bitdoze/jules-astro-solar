---
// src/components/Hero.astro
---
<section class="bg-gradient-to-r from-green-500 via-teal-500 to-blue-600 text-white py-24 md:py-32 px-4 text-center">
  <div class="container mx-auto">
    <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold mb-6 animate-fade-in-down">
      Power Your Future with Solar
    </h1>
    <p class="text-lg sm:text-xl md:text-2xl mb-10 max-w-3xl mx-auto animate-fade-in-up animation-delay-300">
      Discover sustainable and cost-effective solar solutions designed for your home or business.
    </p>
    <a 
      href="/contact" 
      class="bg-yellow-400 text-gray-900 font-bold py-4 px-10 text-lg rounded-lg hover:bg-yellow-300 transform hover:scale-105 transition-all duration-300 ease-in-out shadow-lg hover:shadow-xl"
    >
      Get a Free Quote
    </a>
  </div>
</section>

<style>
  .animate-fade-in-down {
    animation: fadeInDown 0.8s ease-out forwards;
    opacity: 0;
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }
  .animation-delay-300 {
    animation-delay: 0.3s;
  }
  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
